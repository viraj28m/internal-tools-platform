# Application connection: limited role, no UPDATE/DELETE on audit_log.
DATABASE_URL=postgres://app_user:app_password@localhost:5432/internal_tools

# Owner/superuser connection: used only by db:reset and db:migrate, and by
# tests that need to prove the app role is locked out of audit_log.
ADMIN_DATABASE_URL=postgres://postgres@localhost:5432/internal_tools

# Password granted to the application role by db:reset.
APP_DB_PASSWORD=app_password

# Secret used to sign the fake session cookie.
SESSION_SECRET=dev-only-session-secret
